<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Soft shadow bawah -->
    <item>
        <shape android:shape="rectangle">
            <size android:height="76dp"/>
            <solid android:color="#00000000" />
            <padding
                android:bottom="6dp"
                android:left="0dp"
                android:right="0dp"/>
            <corners android:radius="26dp"/>
            <gradient
                android:startColor="#22000000"
                android:endColor="#00000000"
                android:angle="90"/>
        </shape>
    </item>

    <!-- Card utama -->
    <item android:bottom="6dp">
        <shape android:shape="rectangle">

            <!-- Gradient modern -->
            <gradient
                android:startColor="#F7F9FF"
                android:centerColor="#EDF2FF"
                android:endColor="#E9F0FF"
                android:angle="90" />

            <!-- Border clean -->
            <stroke
                android:width="1dp"
                android:color="#D6E2FF" />

            <!-- Rounded -->
            <corners android:radius="26dp" />
        </shape>
    </item>

</layer-list>
